# Settings for scripts/release.sh. Copy this file to scripts/release.local.env
# (not tracked by git) and fill it in. Only this file is read; environment
# variables with the same names are ignored.
#
# Format: KEY=value, one per line, no "export", no spaces around "=".
# A value may be wrapped in "double quotes" (single quotes are not accepted).
# Blank lines and lines starting with # are ignored. Any other line stops the
# script.

# Team ID of the Developer ID Application certificate to sign with
# (the 10 characters in parentheses in `security find-identity -v -p codesigning`).
RAYSNIFF_TEAM_ID=

# notarytool keychain profile, made with:
#   xcrun notarytool store-credentials <profile> --apple-id <Apple ID> --team-id <Team ID>
RAYSNIFF_NOTARY_PROFILE=

# Team IDs that must never be used on this machine, separated by spaces
# (not commas), e.g. RAYSNIFF_FORBIDDEN_TEAM_IDS=ABCDE12345 FGHIJ67890
# (for example an employer's certificate in the same keychain). Optional.
RAYSNIFF_FORBIDDEN_TEAM_IDS=
