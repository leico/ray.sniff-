# Build output (build/, build-test/, build-thread/, ...)
build/
build-*/
externals/
support/
dist/

# Object files / libraries
*.o
*.a
*.dylib

# macOS
.DS_Store

# Xcode / editors
xcuserdata/
*.xcuserstate
.vscode/
.idea/

# Vim backup / swap
# NOTE: Do not use "*~" here; it also matches "ray.sniff~" (the object's own name).
# Many global gitignores contain "*~", so explicitly re-include the object's name.
!ray.sniff~
*.swp
*.swo
*.un~
